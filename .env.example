# Dazzle by Dua Backend Configuration Template
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# Security & JWT Secret Key
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production, SECRET_KEY is strictly required and must be at least 32 characters.
SECRET_KEY=generate_a_cryptographically_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# Optional Initial Admin Setup (One-time only on empty database; CLI 'python create_admin.py' is preferred)
# If used, remove INITIAL_ADMIN_PASSWORD from environment variables after initial deployment.
# INITIAL_ADMIN_USERNAME=your_admin_username
# INITIAL_ADMIN_EMAIL=your_admin_email@domain.com
# INITIAL_ADMIN_PASSWORD=your_strong_admin_password_min_8_chars
# INITIAL_ADMIN_NAME=Store Owner

# MongoDB Configuration
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB=dazzle_by_dua

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Configuration (Test/Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Resend Email Configuration (Admin Order Notifications & Customer Auth)
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_EMAIL=admin@dazzlebydua.com
RESEND_FROM_EMAIL=Dazzle by Dua <orders@dazzlebydua.com>

# Frontend Base URL (Trusted origins for customer password reset links)
FRONTEND_BASE_URL=https://dazzle-by-dua.github.io/Dazzle_frontend
CUSTOMER_ACCESS_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=5
RESET_TOKEN_EXPIRE_MINUTES=20


